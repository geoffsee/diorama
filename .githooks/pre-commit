#!/usr/bin/env bash
# Fast check before a commit is created. Heavier checks run in pre-push.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Honor rust-toolchain.toml. A stable cargo earlier on PATH cannot parse nightly profile keys.
export PATH="${CARGO_HOME:-${HOME}/.cargo}/bin:${PATH}"

run() {
    printf 'pre-commit: %s\n' "$*"
    "$@"
}

run cargo fmt-check
