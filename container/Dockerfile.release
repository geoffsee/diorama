# Release runners build glibc binaries on Ubuntu 24.04. Keep the image ABI aligned.
FROM ubuntu:24.04@sha256:24737cef17f4e22b1977df7d9a05e77c4e28b7da5b8911f8d8ccda136bf3573c

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates iptables nftables conntrack iproute2 kmod e2fsprogs \
        fuse-overlayfs libseccomp2 libsystemd0 libyajl2 \
    && rm -rf /var/lib/apt/lists/*

# Prepared from checksum-pinned upstream binaries, plus this release's diorama.
COPY --chmod=755 bin/ /usr/local/bin/
COPY --chmod=755 cni/bin/ /usr/libexec/cni/
# These archives must survive a fresh data volume; the entrypoint copies them in.
COPY images/coredns.tar.gz images/pause.tar.gz images/local-path-provisioner.tar.gz \
     images/busybox.tar.gz images/portainer-agent.tar.gz images/d2k.tar.gz \
     /usr/local/share/diorama/images/
COPY --chmod=755 entrypoint.sh /usr/local/bin/diorama-entrypoint

VOLUME ["/var/lib/diorama"]
EXPOSE 6443 10250
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/diorama-entrypoint"]
CMD ["--container-mode"]
