      "timeout_seconds": 5
    },
    {
      "id": "no-help",
      "argv": [
        "--no-help"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_equals": "",
        "stderr_contains": [
          "usage: diorama",
          "--[no-]print-config"
        ]
      },
      "timeout_seconds": 5
    }
  ]
}
